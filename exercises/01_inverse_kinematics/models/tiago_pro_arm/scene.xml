<mujoco model="tiago_pro_arm scene">
  <!-- Robot generated by tools/build_tiago_pro_arm.py from PAL Robotics' official description. -->
  <include file="tiago_pro_arm.xml"/>

  <statistic center="0.3 0 0.45" extent="0.9"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25"/>
    <scale framelength="0.12" framewidth="0.006"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
  </asset>

  <!-- The container renders on the CPU, so shadows and floor reflections are off
       (each one costs more than the whole rest of a frame) and the floor is finite.
       Shadows can be switched on in the viewer: Rendering -> Shadow. -->
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" size="1.5 1.5 0.05" type="plane" material="groundplane"/>

    <!-- IK target. In the viewer: double-click it, then Ctrl + right-drag to move,
         Ctrl + left-drag to rotate. -->
    <body name="target" mocap="true" pos="0.45 0.25 0.45" quat="0 0.9659258 0 -0.258819">
      <geom type="sphere" size="0.025" rgba="0.2 0.8 0.2 0.4" contype="0" conaffinity="0"/>
      <site name="target" size="0.005" rgba="0.2 0.8 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
